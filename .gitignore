# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage
expo/coverage/
tests/e2e/*-snapshots/
test-results/
playwright-report/

# next.js
/.next/
/out/

# production
/build

# misc
/mcps
.DS_Store
*.pem

# debug
/terminals/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local
!.env.example
!expo/.env.production.example

# agent/debug scratch scripts
scripts/_tmp-*.mjs
.cleanup-trash-*/

# local Codex plugins and marketplace cache
/.agents/plugins/
/.codex-plugins/

# local UI research recordings (large, not runtime assets)
expo/assets/reference/

# supabase cli
supabase/.temp/

# windows shell accident
$null

# typescript
*.tsbuildinfo
next-env.d.ts

# signing secrets
*.keystore
*.jks
keystore.properties

# expo native prebuild output
/.expo/
expo/.expo/
expo/.qa-*/
expo/node_modules/
artifacts/
claude.md
.supabase-staging/
.env*
docs/CLAUDE_IPA_BUILD_GUIDE.md
backups/

# Vitest 5 artifacts
.vitest/
