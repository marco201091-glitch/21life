{
  "name": "nextjs",
  "version": "9.0.4",
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=20.19.4 <25",
    "npm": ">=10.0.0 <12"
  },
  "scripts": {
    "dev": "node scripts/stop-dev.mjs && next dev --webpack",
    "dev:restart": "node scripts/stop-dev.mjs && next dev --webpack",
    "dev:stop": "node scripts/stop-dev.mjs",
    "build": "node scripts/build-migration-manifest.mjs && next build --webpack",
    "start": "next start",
    "start:standalone": "node scripts/start-standalone.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:all": "vitest run --coverage && node scripts/verify-security.mjs",
    "test:coverage": "vitest run --coverage",
    "quality": "node scripts/build-migration-manifest.mjs && npm run lint && npm run typecheck && npm run test:all && npm run test:scripts && npm run verify:operations-migration && npm run knip:dependencies",
    "test:scripts": "node --test tests/scripts/backup-package.test.mjs tests/scripts/dependency-audit.test.mjs tests/scripts/github-release-assets.test.mjs tests/scripts/migration-manifest.test.mjs",
    "knip": "knip",
    "knip:dependencies": "knip --dependencies",
    "verify:security": "node scripts/verify-security.mjs",
    "verify:operations-migration": "node scripts/verify-operations-migration.mjs",
    "verify:obtainium": "node scripts/verify-obtainium-readiness.mjs",
    "verify:fdroid": "node scripts/verify-fdroid-readiness.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "verify:build-budget": "node scripts/check-build-budgets.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:stress:dev-db": "node scripts/blocked-linked-supabase-command.mjs scripts/qa/v7-history-stress.sql",
    "test:realtime:dev-db": "node scripts/blocked-linked-supabase-command.mjs scripts/qa/v7-realtime-contract.sql",
    "test:remote-guests:dev-db": "node scripts/blocked-linked-supabase-command.mjs scripts/qa/v7-remote-guest-removal.sql",
    "db:apply": "node scripts/selfhosted-db.mjs",
    "test:selfhosted-db-runner": "node --test tests/operations/selfhosted-db-core.test.mjs tests/operations/selfhosted-db-transaction.integration.test.mjs",
    "deploy:dev": "node scripts/deploy-dev.mjs",
    "backup:dev-db": "node scripts/backup-dev-supabase.mjs",
    "verify:dev-db-backup": "node scripts/verify-dev-supabase-backup.mjs",
    "restore-drill:dev-db": "node scripts/restore-drill-dev-supabase.mjs",
    "test:e2e:preflight": "node scripts/e2e-preflight.mjs",
    "test:e2e": "npm run test:e2e:preflight && playwright test",
    "test:e2e:update": "npm run test:e2e:preflight && playwright test --update-snapshots",
    "verify:v7": "npm run quality && npm run build && npm run test:e2e && npm --prefix expo run quality && npm --prefix expo run doctor && npm run expo:ios:ready && npm run expo:ios:bundle:check && npm --prefix expo run android:bundle:check",
    "test:import-images": "node scripts/verify-import-images.mjs",
    "sync:web-favicons": "node scripts/sync-web-favicons.mjs",
    "seed:demo-account": "node scripts/seed-demo-account.mjs",
    "expo:start": "npm --prefix expo run start",
    "expo:android": "npm --prefix expo run android",
    "expo:ios": "npm --prefix expo run ios",
    "expo:ios:config": "npm --prefix expo run ios:config",
    "expo:ios:ready": "npm --prefix expo run ios:ready",
    "expo:ios:bundle:check": "npm --prefix expo run ios:bundle:check",
    "expo:typecheck": "npm --prefix expo run typecheck",
    "expo:eas:init": "npm --prefix expo run eas:init",
    "expo:eas:preview": "npm --prefix expo run eas:build:preview",
    "eas:init": "npm --prefix expo run eas:init",
    "eas:build:preview": "npm --prefix expo run eas:build:preview",
    "eas:build:ios:preview": "npm --prefix expo run eas:build:ios:preview",
    "eas:build:ios:unsigned": "npm --prefix expo run eas:build:ios:unsigned",
    "eas:build:ios:release-unsigned": "npm --prefix expo run eas:build:ios:release-unsigned",
    "eas:build:ios:production": "npm --prefix expo run eas:build:ios:production",
    "eas:env:push": "npm --prefix expo run eas:env:push",
    "eas:build:preview:nowait": "npm --prefix expo run eas:build:preview:nowait"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@next/env": "16.3.8",
    "@radix-ui/react-alert-dialog": "^1.1.1",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-collapsible": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@sentry/nextjs": "^10.75.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.103.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^13.4.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.8",
    "qrcode": "1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.6",
    "react-hook-form": "^7.88.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "knip": "^6.37.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "$sharp"
  },
  "allowScripts": {
    "@sentry/cli@2.58.6": true,
    "esbuild@0.28.1": true,
    "unrs-resolver@1.12.2": true
  }
}
